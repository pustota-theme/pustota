{
  "name": "pustota",
  "displayName": "pustota",
  "description": "Minimalistic VSCode theme inspired by old-fashioned hobbies",
  "version": "0.35.0",
  "scripts": {
    "build": "node src/build.js",
    "check": "node src/build.js --check",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "start": "npm run package",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "pustota",
        "uiTheme": "vs-dark",
        "path": "./themes/pustota-color-theme.json"
      },
      {
        "label": "pustota light",
        "uiTheme": "vs",
        "path": "./themes/pustota-light-color-theme.json"
      },
      {
        "label": "pustota contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/pustota-contrast-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "pustota.injection.ruby.numbers",
        "path": "./syntaxes/ruby-numbers.injection.json",
        "injectTo": ["source.ruby"]
      },
      {
        "scopeName": "pustota.injection.ruby.endless-def",
        "path": "./syntaxes/ruby-endless-def.injection.json",
        "injectTo": ["source.ruby"]
      },
      {
        "scopeName": "pustota.injection.ruby.block-params",
        "path": "./syntaxes/ruby-block-params.injection.json",
        "injectTo": ["source.ruby"]
      },
      {
        "scopeName": "pustota.injection.elixir.defimpl",
        "path": "./syntaxes/elixir-defimpl.injection.json",
        "injectTo": ["source.elixir"]
      },
      {
        "scopeName": "pustota.injection.haskell.types",
        "path": "./syntaxes/haskell-types.injection.json",
        "injectTo": ["source.haskell"]
      },
      {
        "scopeName": "pustota.injection.python.function-names",
        "path": "./syntaxes/python-function-names.injection.json",
        "injectTo": ["source.python"]
      },
      {
        "scopeName": "pustota.injection.c.types",
        "path": "./syntaxes/c-types.injection.json",
        "injectTo": ["source.c"]
      },
      {
        "scopeName": "pustota.injection.go.types",
        "path": "./syntaxes/go-types.injection.json",
        "injectTo": ["source.go"]
      },
      {
        "scopeName": "pustota.injection.typescript.types",
        "path": "./syntaxes/typescript-types.injection.json",
        "injectTo": ["source.ts", "source.tsx"]
      }
    ]
  },
  "publisher": "sobolevn",
  "homepage": "https://github.com/pustota-theme/pustota",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pustota-theme/pustota.git"
  },
  "bugs": {
    "url": "https://github.com/pustota-theme/pustota/issues",
    "email": "mail@sobolevn.me"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
